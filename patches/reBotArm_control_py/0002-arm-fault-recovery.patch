     def _make_controller(self, vendor: str) -> Controller:
         """按 channel 类型创建 Controller，与 motorbridge 官方示例一致。"""
-        if self._channel.startswith("/dev/tty"):
+        # Stable udev aliases and /dev/serial/by-id links are serial devices
