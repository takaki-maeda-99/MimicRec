+    def _limit_mit_command(
+        self,
+        pos: float,
+        vel: float,
+        kp: float,
+        kd: float,
+        tau: float,
+        limit: float,
+    ) -> tuple[float, float, float, float, float]:
+        """Clamp estimated kp*position_error + kd*velocity_error + tau.
+
+        MIT mode has no standalone torque-limit register, so the position or
+        velocity target is moved just enough to keep the motor-side PD sum
+        within the configured limit.  If feedback is not available yet, PD is
+        disabled for that cycle; this fails closed instead of sending an
+        unbounded position error.
+        """
+        # Complete the feedback transaction requested by the previous MIT
+        # command before reading the cached state.  The Damiao serial bridge
+        # needs this second poll; without it the limiter can keep seeing the
+        # initial position and repeatedly emit the same one-step target.
+        self._poll()
+        try:
+            state = self._mot.get_state()
+        except Exception:
+            state = None
+
+        if state is None:
+            return pos, vel, 0.0, 0.0, float(np.clip(tau, -limit, limit))
+
+        current_pos = float(state.pos)
+        current_vel = float(state.vel)
+        if not isfinite(current_pos) or not isfinite(current_vel):
+            return pos, vel, 0.0, 0.0, float(np.clip(tau, -limit, limit))
+
+        predicted = (
+            kp * (pos - current_pos)
+            + kd * (vel - current_vel)
+            + tau
+        )
+        limited_total = float(np.clip(predicted, -limit, limit))
+        limited_tau = float(np.clip(tau, -limit, limit))
+
+        if abs(kp) > 1e-9:
+            pos = current_pos + (
+                limited_total
+                - kd * (vel - current_vel)
+                - limited_tau
+            ) / kp
+        elif abs(kd) > 1e-9:
+            vel = current_vel + (limited_total - limited_tau) / kd
+        else:
+            limited_tau = limited_total
+
+        return pos, vel, kp, kd, limited_tau
