[Unit]
Description=MimicRec Quest ROS 2 bridge
After=network-online.target
Wants=network-online.target
ConditionPathExists=@REPO_ROOT@/.ros2_quest_ws/install/setup.bash
ConditionFileIsExecutable=@REPO_ROOT@/scripts/run_quest_ros2.sh
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-%h/.config/mimicrec/quest.env
ExecStart="@REPO_ROOT@/scripts/run_quest_ros2.sh"
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.ros
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mimicrec-quest

[Install]
WantedBy=default.target
